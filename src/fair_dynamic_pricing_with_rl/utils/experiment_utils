import numpy as np


def argmedian(arr: np.ndarray):
    """Function for returning index of median.
    Args:
        arr (np.ndarray): array

    Returns:
        np.argpartition(arr, len(arr) // 2)[len(arr) // 2] (int): index of median
    """
    return np.argpartition(arr, len(arr) // 2)[len(arr) // 2]
